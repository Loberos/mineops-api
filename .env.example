# Copiar a .env y ajustar antes de ejecutar `docker compose up`.

# --- PostgreSQL ---
POSTGRES_DB=mineops
POSTGRES_USER=mineops
POSTGRES_PASSWORD=mineops
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
# Mínimo 32 bytes. Se genera con: openssl rand -base64 48
JWT_SECRET=mineops-local-development-secret-key-change-me
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
# Carga el conjunto de demostración (los casos borde descritos en el README) si la base está vacía.
SEED_ENABLED=true

# --- Web ---
WEB_PORT=8081
WEB_API_BASE_URL=http://localhost:8080/api/v1
